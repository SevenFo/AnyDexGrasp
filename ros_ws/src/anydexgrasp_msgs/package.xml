  <version>1.0.0</version>
  <description>Custom message and service definitions for AnyDexGrasp project</description>

  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>MIT</license>
  
  <url type="website">https://github.com/your_username/AnyDexGrasp</url>
